{
  "version": 1,
  "templates": [
    {"path": "AGENTS.md", "class": "fixed part", "mode": "100644"},
    {"path": ".claude/CLAUDE.md", "class": "fixed part", "mode": "100644"},
    {"path": "docs/agents/review.md", "class": "fixed", "mode": "100644"},
    {"path": "docs/agents/build.md", "class": "skeleton", "mode": "100644"},
    {"path": ".github/governance/owner.sh", "class": "fixed", "mode": "100755"},
    {"path": ".github/governance/record.yml", "class": "record", "mode": "100644"}
