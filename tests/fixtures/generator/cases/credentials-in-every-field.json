{
  "description": "#41 \u00a710: credentials in an npm script, a documented command, a private key in a shell block and an open PR's title are located by type and line, and no value reaches any output: each command's text is redacted and the key's lines are dropped.",
  "expect": {
    "inspect": {
      "exit": 0,
      "credentials": [
        {
          "type": "GitHub token",
          "path": "README.md",
          "line": 4
        },
        {
          "type": "private key",
          "path": "README.md",
          "line": 6
        },
        {
          "type": "GitHub token",
          "path": "package.json",
          "line": 6
        }
      ],
      "commands": {
        "manifests": [
          {
            "path": "package.json",
            "commands": [
              {
                "command": "npm run build",
                "runs": "tsc -p ."
              },
              {
                "command": "npm run release",
                "runs": "GITHUB_TOKEN=<redacted GitHub token> npm publish"
              }
            ]
          }
        ],
        "documents": [
          {
            "path": "README.md",
            "line": 4,
            "command": "gh auth login --with-token <<< <redacted GitHub token>"
          },
          {
            "path": "README.md",
            "line": 5,
            "command": "cat > key <<'EOF'"
          },
          {
            "path": "README.md",
            "line": 9,
            "command": "npm test"
          }
        ]
      },
      "github": {
        "open_pull_requests": [
          {
            "number": 21,
            "title": "Rotate <redacted GitHub token>",
            "author": "Habit130",
            "draft": false
          }
        ]
      }
    }
  },
  "github": {
    "pulls": [
      {
        "number": 21,
        "title": "Rotate <planted:github-token>",
        "user": {
          "login": "Habit130"
        },
        "draft": false
      }
    ]
  },
  "harness": "claude-code",
  "repository": {
    "files": {
      "package.json": "{\n  \"name\": \"tally\",\n  \"version\": \"0.4.0\",\n  \"scripts\": {\n    \"build\": \"tsc -p .\",\n    \"release\": \"GITHUB_TOKEN=<planted:github-token> npm publish\"\n  }\n}\n",
      "README.md": "# tally\n\n```sh\ngh auth login --with-token <<< <planted:github-token>\ncat > key <<'EOF'\n<planted:private-key>\n<planted:private-key-body>\n<planted:private-key-end>\nnpm test\n```\n"
    }
  },
  "run": [
    "inspect"
  ]
}
