{
  "description": "#38: workflows referencing Actions secrets, GITHUB_TOKEN excluded; a path-filtered job, a matrix and a reusable workflow; build commands from a Makefile and a document.",
  "expect": {
    "inspect": {
      "ci": {
        "secrets": [
          "DOCS_DEPLOY_KEY",
          "NPM_TOKEN"
        ],
        "workflows": [
          {
            "path": ".github/workflows/ci.yml",
            "jobs": [
              {
                "id": "test",
                "every_pr": true
              }
            ]
          },
          {
            "path": ".github/workflows/docs.yml",
            "secrets": [
              "DOCS_DEPLOY_KEY"
            ],
            "jobs": [
              {
                "id": "docs",
                "every_pr": false,
                "uncertain": false
              }
            ]
          },
          {
            "path": ".github/workflows/matrix.yml",
            "secrets_inherit": true,
            "uncertain": [
              "shared",
              "test"
            ],
            "jobs": [
              {
                "id": "shared",
                "every_pr": true,
                "uncertain": true
              },
              {
                "id": "test",
                "every_pr": true,
                "uncertain": true
              }
            ]
          },
          {
            "path": ".github/workflows/release.yml",
            "secrets": [
              "NPM_TOKEN"
            ],
            "jobs": [
              {
                "id": "publish",
                "every_pr": false
              }
            ]
          }
        ]
      },
      "commands": {
        "manifests": [
          {
            "path": "Makefile",
            "commands": [
              {
                "command": "make build"
              },
              {
                "command": "make test"
              }
            ]
          },
          {
            "path": "package.json",
            "tool": "npm"
          }
        ],
        "documents": [
          {
            "path": "docs/agents/build.md",
            "line": 4,
            "command": "npm ci"
          },
          {
            "path": "docs/agents/build.md",
            "line": 5,
            "command": "npm test"
          }
        ]
      }
    }
  },
  "harness": "claude-code",
  "repository": {
    "files": {
      ".github/workflows/release.yml": "name: release\non:\n  push:\n    tags: ['v*']\njobs:\n  publish:\n    runs-on: ubuntu-24.04\n    steps:\n      - run: npm publish\n        env:\n          NODE_AUTH_TOKEN: ${{ secrets.NPM_TOKEN }}\n          GH: ${{ secrets.GITHUB_TOKEN }}\n",
      ".github/workflows/docs.yml": "on:\n  pull_request:\n    paths:\n      - 'docs/**'\njobs:\n  docs:\n    runs-on: ubuntu-24.04\n    steps:\n      - uses: actions/checkout@v4\n      - run: |\n          echo ${{ secrets['DOCS_DEPLOY_KEY'] }}\n          make docs\n",
      ".github/workflows/matrix.yml": "on: [pull_request, push]\njobs:\n  test:\n    strategy:\n      matrix:\n        node: [20, 22]\n    runs-on: ubuntu-24.04\n    steps:\n      - run: npm test\n  shared:\n    uses: ./.github/workflows/shared.yml\n    secrets: inherit\n",
      "Makefile": "build:\n\tnpm run build\n\ntest: build\n\tnpm test\n",
      "docs/agents/build.md": "# Build\n\n```sh\n$ npm ci\nnpm test\n```\n"
    }
  },
  "run": [
    "inspect"
  ]
}
