{
  "description": "A ruleset whose pattern uses a form GitHub doesn't support (a backslash, or a set complemented with ^) has no known reading there: it is neither removed nor called kept but fails with the reason and stays untouched, while a ruleset that does apply to the default branch is still removed.",
  "visibility": "public",
  "required_checks": [
    "test"
  ],
  "start": "target",
  "github": {
    "rulesets": [
      {
        "as_target": "Gate"
      },
      {
        "as_target": "Merge"
      },
      {
        "as_target": "History"
      },
      {
        "id": 801,
        "name": "escaped",
        "target": "branch",
        "enforcement": "active",
        "bypass_actors": [],
        "conditions": {
          "ref_name": {
            "include": [
              "~ALL"
            ],
            "exclude": [
              "refs/heads/ma\\in"
            ]
          }
        },
        "rules": [
          {
            "type": "deletion"
          }
        ]
      },
      {
        "id": 802,
        "name": "complemented",
        "target": "branch",
        "enforcement": "active",
        "bypass_actors": [],
        "conditions": {
          "ref_name": {
            "include": [
              "refs/heads/[^x]ain"
            ],
            "exclude": []
          }
        },
        "rules": [
          {
            "type": "deletion"
          }
        ]
      },
      {
        "id": 803,
        "name": "legacy main",
        "target": "branch",
        "enforcement": "active",
        "bypass_actors": [],
        "conditions": {
          "ref_name": {
            "include": [
              "refs/heads/main"
            ],
            "exclude": []
          }
        },
        "rules": [
          {
            "type": "deletion"
          }
        ]
      }
    ]
  },
  "writes": [
    [
      "DELETE",
      "rulesets/803"
    ]
  ],
  "exit": 1,
  "report": [
    [
      "通过",
      "账户"
    ],
    [
      "通过",
      "副本"
    ],
    [
      "通过",
      "记录"
    ],
    [
      "已就位",
      "Actions 可运行工作流"
    ],
    [
      "已就位",
      "Gate 规则集"
    ],
    [
      "已就位",
      "Merge 规则集"
    ],
    [
      "已就位",
      "History 规则集"
    ],
    [
      "未通过",
      "规则集 “escaped”（id 801，branch）"
    ],
    [
      "未通过",
      "规则集 “complemented”（id 802，branch）"
    ],
    [
      "已移除",
      "规则集 “legacy main”（id 803，branch）"
    ],
    [
      "已就位",
      "main 的经典分支保护"
    ],
    [
      "已就位",
      "仅 squash 合并"
    ],
    [
      "已就位",
      "合并后删除 head 分支"
    ],
    [
      "已就位",
      "auto-merge 关闭"
    ],
    [
      "已就位",
      "Actions 不能创建或批准 PR"
    ],
    [
      "已就位",
      "secret scanning"
    ],
