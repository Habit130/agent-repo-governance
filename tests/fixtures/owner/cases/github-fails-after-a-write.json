{
  "description": "GitHub fails a read after the rulesets were written: the report names the section it stopped in and what was written, and the run exits 1 so habit reruns it.",
  "visibility": "public",
  "required_checks": [
    "test"
  ],
  "start": "nothing",
  "github": {
    "failing_reads": {
      "actions/permissions/workflow": 500
    }
  },
  "writes": [
    [
      "POST",
      "rulesets",
      {
        "ruleset": "Gate"
      }
    ],
    [
      "POST",
      "rulesets",
      {
        "ruleset": "Merge"
      }
    ],
    [
      "POST",
      "rulesets",
      {
        "ruleset": "History"
      }
    ],
    [
      "PATCH",
      "",
      {
        "allow_merge_commit": false,
        "allow_rebase_merge": false,
        "delete_branch_on_merge": true
      }
    ]
  ],
  "exit": 1,
  "report": [
    [
      "通过",
      "账户"
    ],
    [
      "通过",
      "副本"
    ],
    [
      "通过",
      "记录"
    ],
    [
      "已就位",
      "Actions 可运行工作流"
    ],
    [
      "已设置",
      "Gate 规则集"
    ],
    [
      "已设置",
      "Merge 规则集"
    ],
    [
      "已设置",
      "History 规则集"
    ],
    [
      "已就位",
      "main 的经典分支保护"
    ],
    [
      "已设置",
      "仅 squash 合并"
    ],
    [
      "已设置",
      "合并后删除 head 分支"
    ],
    [
      "已就位",
      "auto-merge 关闭"
    ],
    [
      "未通过",
      "设置"
    ]
  ]
}
