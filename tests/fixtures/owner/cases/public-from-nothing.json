{
  "description": "A public repository from nothing, with a confirmed required check: the three rulesets, the settings that differ, secret scanning, push protection and the event policy are written; Actions already can't create or approve PRs, GitHub's default for a personal repository.",
  "visibility": "public",
  "required_checks": [
    "test"
  ],
  "start": "nothing",
  "writes": [
    [
      "POST",
      "rulesets",
      {
        "ruleset": "Gate"
      }
    ],
    [
      "POST",
      "rulesets",
      {
        "ruleset": "Merge"
      }
    ],
    [
      "POST",
      "rulesets",
      {
        "ruleset": "History"
      }
    ],
    [
      "PATCH",
      "",
      {
        "allow_merge_commit": false,
        "allow_rebase_merge": false,
        "delete_branch_on_merge": true
      }
    ],
    [
      "PATCH",
      "",
      {
        "security_and_analysis": {
          "secret_scanning": {
            "status": "enabled"
          },
          "secret_scanning_push_protection": {
            "status": "enabled"
          }
        }
      }
    ],
    [
      "POST",
      "actions/policies",
      {
        "event_policy": "target"
      }
    ]
  ],
  "exit": 0,
  "report": [
    [
      "通过",
      "账户"
    ],
    [
      "通过",
      "副本"
    ],
    [
      "通过",
      "记录"
    ],
    [
      "已就位",
      "Actions 可运行工作流"
    ],
    [
      "已设置",
      "Gate 规则集"
    ],
    [
      "已设置",
      "Merge 规则集"
    ],
    [
      "已设置",
      "History 规则集"
    ],
    [
      "已就位",
      "main 的经典分支保护"
    ],
    [
      "已设置",
      "仅 squash 合并"
    ],
    [
      "已设置",
      "合并后删除 head 分支"
    ],
    [
      "已就位",
      "auto-merge 关闭"
    ],
    [
      "已就位",
      "Actions 不能创建或批准 PR"
    ],
    [
      "已设置",
      "secret scanning"
    ],
    [
      "已设置",
      "push protection"
    ],
    [
      "已设置",
      "pull_request_target 事件策略"
    ]
  ]
}
