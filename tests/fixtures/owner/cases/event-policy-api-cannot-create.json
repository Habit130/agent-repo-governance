{
  "description": "GitHub's API refuses to create the event policy on this personal-account repository: the policy is reported missing, in Chinese, with habit's one-time setting in Settings → Actions → Policies, and the run exits 1.",
  "visibility": "public",
  "required_checks": [
    "test"
  ],
  "start": "target",
  "github": {
    "event_policy": "none"
  },
  "writes": [
    [
      "POST",
      "actions/policies",
      {
        "event_policy": "target"
      }
    ]
  ],
  "answers": {
    "POST actions/policies": {
      "status": 422,
      "message": "Actions policies are not available for this repository"
    }
  },
  "exit": 1,
  "report": [
    [
      "通过",
      "账户"
    ],
    [
      "通过",
      "副本"
    ],
    [
      "通过",
      "记录"
    ],
    [
      "已就位",
      "Actions 可运行工作流"
    ],
    [
      "已就位",
      "Gate 规则集"
    ],
    [
      "已就位",
      "Merge 规则集"
    ],
    [
      "已就位",
      "History 规则集"
    ],
    [
