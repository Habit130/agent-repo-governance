{
  "description": "Actions allows only the repository's own actions, which blocks the gate's actions/checkout: the run stops before any write.",
  "visibility": "public",
  "required_checks": [
    "test"
  ],
  "start": "nothing",
  "github": {
    "actions": {
      "allowed_actions": "local_only"
    }
  },
  "writes": [],
  "exit": 2,
  "report": [
    [
      "通过",
      "账户"
    ],
    [
      "通过",
      "副本"
    ],
    [
      "通过",
      "记录"
    ],
    [
      "未通过",
      "前提"
    ]
  ]
}
